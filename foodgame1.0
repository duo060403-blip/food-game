<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#FFF6EA">
<title>爆忙！一人食堂 🍽️</title>
<style>
  :root{
    --cream:#FFF6EA;
    --card:#FFFDF8;
    --coral:#FF7E67;
    --coral-deep:#F0644B;
    --yellow:#FFD166;
    --brown:#5B3A29;
    --sub:#C98F6B;
    --line:#FFE0C4;
    --shadow:0 6px 18px rgba(214,150,102,.20);
  }
  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
  html,body{height:100%;}
  body{
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
    background:
      radial-gradient(circle at 15% 20%, #FFE9C9 0%, transparent 45%),
      radial-gradient(circle at 85% 80%, #FFD9DE 0%, transparent 45%),
      var(--cream);
    color:var(--brown);
    overflow-x:hidden;
    user-select:none;-webkit-user-select:none;
  }
  .bg{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden;}
  .bg span{position:absolute;font-size:36px;opacity:.16;animation:float 9s ease-in-out infinite;}
  .bg span:nth-child(1){top:6%;left:4%;animation-delay:0s;}
  .bg span:nth-child(2){top:12%;right:6%;animation-delay:1.4s;}
  .bg span:nth-child(3){bottom:16%;left:8%;animation-delay:2.6s;}
  .bg span:nth-child(4){bottom:10%;right:12%;animation-delay:.8s;}
  .bg span:nth-child(5){top:48%;left:2%;animation-delay:3.4s;}
  .bg span:nth-child(6){top:52%;right:2%;animation-delay:2s;}
  @keyframes float{0%,100%{transform:translateY(0) rotate(-5deg);}50%{transform:translateY(-16px) rotate(6deg);}}
  .game{position:relative;z-index:1;max-width:520px;margin:0 auto;padding:14px 14px 22px;min-height:100vh;min-height:100dvh;display:flex;flex-direction:column;gap:12px;}
  .top-bar{display:flex;gap:10px;}
  .score-box,.timer-box{flex:1;background:var(--card);border:3px solid var(--line);border-radius:16px;box-shadow:var(--shadow);padding:10px 12px;}
  .label{font-size:12px;font-weight:700;color:var(--sub);letter-spacing:1px;}
  .score-box .value{font-size:28px;font-weight:900;color:var(--coral);line-height:1.1;}
  .score-box .value.bump{animation:bump .35s ease;}
  .timer-box{text-align:right;}
  .timer-box .value{font-size:22px;font-weight:900;line-height:1.1;}
  .timer-track{margin-top:6px;height:12px;background:#F7E3CF;border-radius:99px;overflow:hidden;}
  .timer-fill{height:100%;width:100%;border-radius:99px;background:linear-gradient(90deg,var(--yellow),var(--coral));transition:width .1s linear;}
  .timer-fill.danger{background:linear-gradient(90deg,var(--coral),#E63946);animation:blink .5s steps(2) infinite;}
  @keyframes blink{50%{opacity:.55;}}
  .order-area{position:relative;background:var(--card);border:3px solid var(--line);border-radius:20px;box-shadow:var(--shadow);padding:12px 14px;}
  .order-area.burst{animation:pop .45s cubic-bezier(.34,1.56,.64,1);}
  .order-head{display:flex;align-items:center;gap:10px;margin-bottom:8px;}
  .customer{width:52px;height:52px;border-radius:50%;background:#FFF3E2;border:2px solid var(--line);display:grid;place-items:center;font-size:30px;box-shadow:inset 0 -3px 0 rgba(214,150,102,.15);}
  .order-title{font-weight:900;font-size:16px;}
  .order-sub{font-size:12px;color:var(--sub);}
  .order-items{display:flex;gap:10px;flex-wrap:wrap;min-height:66px;align-items:center;}
  .order-chip{display:flex;flex-direction:column;align-items:center;gap:2px;background:#FFF8EC;border:2px dashed #F5C79A;border-radius:14px;padding:7px 12px;animation:pop .35s cubic-bezier(.34,1.56,.64,1);}
  .order-chip .e{font-size:28px;}
  .order-chip .n{font-size:12px;font-weight:800;}
  .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;}
  .food-btn{position:relative;aspect-ratio:1/1;border:none;border-radius:20px;background:var(--card);border:3px solid var(--line);box-shadow:var(--shadow);cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;transition:transform .12s,box-shadow .12s,background .15s,border-color .15s;touch-action:manipulation;font-family:inherit;}
  .food-btn:active{transform:scale(.92);}
  .food-btn:hover{transform:translateY(-3px);box-shadow:0 10px 22px rgba(214,150,102,.3);}
  .food-btn:focus-visible{outline:3px solid var(--yellow);outline-offset:2px;}
  .food-btn .e{font-size:clamp(32px,10vw,46px);transition:transform .15s;line-height:1;}
  .food-btn .n{font-size:12px;font-weight:800;color:var(--sub);}
  .food-btn.hint{animation:hintPulse 1.5s ease-in-out infinite;}
  .food-btn.picked{background:#FFE9D8;border-color:var(--coral);}
  .food-btn.picked .e{transform:scale(1.15);}
  .food-btn.wrong{animation:shake .4s ease;}
  @keyframes hintPulse{0%,100%{box-shadow:0 0 0 0 rgba(255,209,102,.5);}50%{box-shadow:0 0 0 9px rgba(255,209,102,0);}}
  @keyframes shake{0%,100%{transform:translateX(0);}20%{transform:translateX(-7px);}40%{transform:translateX(7px);}60%{transform:translateX(-4px);}80%{transform:translateX(4px);}}
  @keyframes pop{0%{transform:scale(.6);}60%{transform:scale(1.08);}100%{transform:scale(1);}}
  @keyframes bump{0%{transform:scale(1);}40%{transform:scale(1.4);}100%{transform:scale(1);}}
  .tray{display:flex;align-items:center;gap:8px;}
  .tray-items{flex:1;min-height:46px;background:var(--card);border:3px solid var(--line);border-radius:14px;box-shadow:var(--shadow);padding:6px 10px;display:flex;align-items:center;gap:6px;font-size:24px;overflow-x:auto;color:var(--sub);font-weight:700;}
  .clear-btn{flex-shrink:0;background:#FFE9D8;border:3px solid var(--coral);color:var(--coral);font-weight:900;border-radius:14px;padding:10px 14px;cursor:pointer;box-shadow:var(--shadow);font-size:14px;font-family:inherit;touch-action:manipulation;}
  .clear-btn:active{transform:scale(.94);}
  .hint-text{text-align:center;font-size:12px;color:var(--sub);font-weight:600;}
  .toast{position:fixed;left:50%;top:14%;transform:translate(-50%,-10px);background:var(--card);border:3px solid var(--coral);color:var(--coral);font-weight:900;padding:9px 18px;border-radius:99px;box-shadow:var(--shadow);opacity:0;pointer-events:none;transition:all .25s;z-index:40;font-size:14px;white-space:nowrap;}
  .toast.show{opacity:1;transform:translate(-50%,0);}
  .spark{position:fixed;font-size:22px;pointer-events:none;z-index:30;animation:fly .7s ease-out forwards;}
  @keyframes fly{to{transform:translate(var(--dx),var(--dy)) scale(.3) rotate(20deg);opacity:0;}}
  .modal{position:fixed;inset:0;background:rgba(91,58,41,.45);backdrop-filter:blur(3px);display:grid;place-items:center;z-index:50;opacity:0;pointer-events:none;transition:opacity .3s;padding:20px;}
  .modal.show{opacity:1;pointer-events:auto;}
  .modal-card{background:var(--card);border:4px solid var(--line);border-radius:26px;box-shadow:0 18px 50px rgba(0,0,0,.25);padding:28px 34px;text-align:center;transform:scale(.8);transition:transform .35s cubic-bezier(.34,1.56,.64,1);max-width:320px;width:100%;}
  .modal.show .modal-card{transform:scale(1);}
  .modal-card .big{font-size:54px;}
  .modal-card h2{margin:8px 0 6px;font-size:24px;}
  .final-score{font-size:56px;font-weight:900;color:var(--coral);line-height:1.1;}
  .rank-text{font-size:13px;color:var(--sub);margin-top:6px;font-weight:700;}
  .replay-btn{margin-top:18px;width:100%;background:linear-gradient(135deg,var(--yellow),var(--coral));color:#fff;border:none;font-size:18px;font-weight:900;padding:13px 28px;border-radius:99px;cursor:pointer;box-shadow:0 8px 18px rgba(255,126,103,.4);font-family:inherit;touch-action:manipulation;}
  .replay-btn:active{transform:scale(.96);}
  @media (max-width:420px){
    .game{padding:10px 10px 18px;gap:10px;}
    .grid{gap:8px;}
    .food-btn{border-radius:16px;}
    .order-chip{padding:5px 9px;}
    .customer{width:46px;height:46px;font-size:26px;}
  }
</style>
</head>
<body>
<div class="bg">
  <span>🍔</span><span>🍣</span><span>🍜</span><span>🧋</span><span>🍢</span><span>🍰</span>
</div>

<div class="game">
  <header class="top-bar">
    <div class="score-box">
      <div class="label">🍭 得分</div>
      <div class="value" id="score">0</div>
    </div>
    <div class="timer-box">
      <div class="label">⏱️ 剩余时间</div>
      <div class="value" id="time">60s</div>
      <div class="timer-track"><div class="timer-fill" id="timerFill"></div></div>
    </div>
  </header>

  <section class="order-area" id="orderArea">
    <div class="order-head">
      <div class="customer" id="customer">👧</div>
      <div>
        <div class="order-title">🛎️ 新订单来啦！</div>
        <div class="order-sub">顾客想吃…</div>
      </div>
    </div>
    <div class="order-items" id="orderItems"></div>
  </section>

  <section class="grid" id="grid"></section>

  <div class="tray">
    <div class="tray-items" id="tray">👐 你的托盘是空的</div>
    <button class="clear-btn" id="clearBtn">🗑️ 清空</button>
  </div>
  <p class="hint-text">💡 按订单点餐，凑齐组合自动上菜；点错会清空托盘哦～</p>
</div>

<div class="toast" id="toast"></div>

<div class="modal" id="modal">
  <div class="modal-card">
    <div class="big">🍳</div>
    <h2>打烊啦！</h2>
    <div class="label">本次得分</div>
    <div class="final-score" id="finalScore">0</div>
    <p class="rank-text" id="rankText"></p>
    <button class="replay-btn" id="replayBtn">🔁 再玩一次</button>
  </div>
</div>

<script>
const FOODS = [
  { id:'burger',   emoji:'🍔', name:'汉堡' },
  { id:'sushi',    emoji:'🍣', name:'寿司' },
  { id:'ramen',    emoji:'🍜', name:'拉面' },
  { id:'cake',     emoji:'🍰', name:'甜点' },
  { id:'milktea',  emoji:'🧋', name:'奶茶' },
  { id:'skewer',   emoji:'🍢', name:'烤串' },
  { id:'dumpling', emoji:'🥟', name:'饺子' },
  { id:'icecream', emoji:'🍦', name:'冰淇淋' },
  { id:'pancake',  emoji:'🥞', name:'松饼' }
];
const CUSTOMERS = ['👧','🧒','👦','👩','🧑','👨','👵','👴','🧑‍🍳'];

const gridEl      = document.getElementById('grid');
const orderArea   = document.getElementById('orderArea');
const orderItems  = document.getElementById('orderItems');
const customerEl  = document.getElementById('customer');
const trayEl      = document.getElementById('tray');
const clearBtn    = document.getElementById('clearBtn');
const scoreEl     = document.getElementById('score');
const timeEl      = document.getElementById('time');
const timerFill   = document.getElementById('timerFill');
const toastEl     = document.getElementById('toast');
const modalEl     = document.getElementById('modal');
const finalScoreEl= document.getElementById('finalScore');
const rankTextEl  = document.getElementById('rankText');
const replayBtn   = document.getElementById('replayBtn');

let order=[], selected=[], score=0, timeLeft=60, gameOver=false, lock=false, timerId=null, toastTimer=null;

function shuffle(arr){
  const a=[...arr];
  for(let i=a.length-1;i>0;i--){
    const j=Math.floor(Math.random()*(i+1));
    [a[i],a[j]]=[a[j],a[i]];
  }
  return a;
}

function buildGrid(){
  gridEl.innerHTML='';
  FOODS.forEach(f=>{
    const b=document.createElement('button');
    b.className='food-btn';
    b.dataset.id=f.id;
    b.innerHTML='<span class="e">'+f.emoji+'</span><span class="n">'+f.name+'</span>';
    b.addEventListener('click',()=>onFoodClick(f.id));
    gridEl.appendChild(b);
  });
}

function newOrder(){
  const picked=shuffle(FOODS).slice(0,2+Math.floor(Math.random()*2)); // 2~3 种
  order=picked.map(f=>f.id);
  customerEl.textContent=CUSTOMERS[Math.floor(Math.random()*CUSTOMERS.length)];
  orderItems.innerHTML='';
  picked.forEach(f=>{
    const chip=document.createElement('div');
    chip.className='order-chip';
    chip.innerHTML='<span class="e">'+f.emoji+'</span><span class="n">'+f.name+'</span>';
    orderItems.appendChild(chip);
  });
  document.querySelectorAll('.food-btn').forEach(b=>{
    b.classList.toggle('hint',order.includes(b.dataset.id));
  });
  orderArea.classList.remove('burst');
  selected=[];
  renderTray();
}

function renderTray(){
  if(selected.length===0){
    trayEl.innerHTML='👐 你的托盘是空的';
  }else{
    trayEl.innerHTML='';
    selected.forEach(id=>{
      const f=FOODS.find(x=>x.id===id);
      const s=document.createElement('span');
      s.textContent=f.emoji;
      trayEl.appendChild(s);
    });
  }
  document.querySelectorAll('.food-btn').forEach(b=>{
    b.classList.toggle('picked',selected.includes(b.dataset.id));
  });
}

function onFoodClick(id){
  if(gameOver||lock) return;
  const need =order.filter(x=>x===id).length;
  const have =selected.filter(x=>x===id).length;
  if(need===0||have>=need){
    sBad();
    const btn=document.querySelector('.food-btn[data-id="'+id+'"]');
    if(btn){btn.classList.add('wrong');setTimeout(()=>btn.classList.remove('wrong'),450);}
    selected=[];
    renderTray();
    showToast(need===0 ? '这个不在订单里哦～' : '已经拿太多啦！');
    return;
  }
  selected.push(id);
  sPick();
  renderTray();
  if(matchOrder()) success();
}

function matchOrder(){
  return [...selected].sort().join(',')===[...order].sort().join(',');
}

function success(){
  lock=true;
  sGood();
  score++;
  scoreEl.textContent=score;
  scoreEl.classList.remove('bump');
  void scoreEl.offsetWidth;
  scoreEl.classList.add('bump');
  orderArea.classList.add('burst');
  spawnSparks();
  showToast('🎉 上菜成功 +1');
  setTimeout(()=>{newOrder();lock=false;},420);
}

function spawnSparks(){
  const rect=orderArea.getBoundingClientRect();
  const cx=rect.left+rect.width/2, cy=rect.top+rect.height/2;
  const emojis=['✨','⭐','💛','🍀','🎉'];
  for(let i=0;i<10;i++){
    const s=document.createElement('span');
    s.className='spark';
    s.textContent=emojis[Math.floor(Math.random()*emojis.length)];
    const ang=Math.random()*Math.PI*2, dist=60+Math.random()*90;
    s.style.setProperty('--dx',Math.cos(ang)*dist+'px');
    s.style.setProperty('--dy',Math.sin(ang)*dist+'px');
    s.style.left=cx+'px';
    s.style.top=cy+'px';
    document.body.appendChild(s);
    setTimeout(()=>s.remove(),750);
  }
}

function showToast(msg){
  toastEl.textContent=msg;
  toastEl.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>toastEl.classList.remove('show'),1100);
}

clearBtn.addEventListener('click',()=>{
  if(gameOver||lock) return;
  selected=[];
  renderTray();
});

function startTimer(){
  timeLeft=60;
  timerFill.style.width='100%';
  timerFill.classList.remove('danger');
  timeEl.textContent='60s';
  clearInterval(timerId);
  timerId=setInterval(()=>{
    timeLeft=Math.max(0,timeLeft-.1);
    const secs=Math.ceil(timeLeft);
    timeEl.textContent=secs+'s';
    timerFill.style.width=(timeLeft/60*100)+'%';
    timerFill.classList.toggle('danger',timeLeft<=10);
    if(timeLeft<=0){clearInterval(timerId);endGame();}
  },100);
}

function endGame(){
  gameOver=true;
  sEnd();
  finalScoreEl.textContent=score;
  rankTextEl.textContent=rankOf(score);
  modalEl.classList.add('show');
}

function rankOf(s){
  if(s>=30) return '🏅 五星大厨！速度惊人！';
  if(s>=20) return '🥈 金牌主厨，再来一单！';
  if(s>=10) return '🥉 越来越熟练啦！';
  return '🌱 刚开业，继续加油！';
}

function resetGame(){
  score=0;
  scoreEl.textContent='0';
  gameOver=false;
  lock=false;
  modalEl.classList.remove('show');
  newOrder();
  startTimer();
}

replayBtn.addEventListener('click',resetGame);

/* ---- 简单音效（WebAudio，无外部资源） ---- */
let audioCtx=null;
function beep(freq,dur,type,vol){
  try{
    audioCtx=audioCtx||new (window.AudioContext||window.webkitAudioContext)();
    const o=audioCtx.createOscillator(), g=audioCtx.createGain();
    o.type=type;
    o.frequency.value=freq;
    g.gain.setValueAtTime(vol,audioCtx.currentTime);
    g.gain.exponentialRampToValueAtTime(.001,audioCtx.currentTime+dur);
    o.connect(g).connect(audioCtx.destination);
    o.start();
    o.stop(audioCtx.currentTime+dur);
  }catch(e){}
}
function sPick(){beep(520,.06,'triangle',.12);}
function sGood(){beep(660,.09,'triangle',.14);setTimeout(()=>beep(880,.12,'triangle',.14),80);}
function sBad(){beep(180,.18,'sawtooth',.07);}
function sEnd(){[523,659,784].forEach((f,i)=>setTimeout(()=>beep(f,.18,'triangle',.14),i*130));}

/* ---- 启动 ---- */
buildGrid();
newOrder();
startTimer();
</script>
</body>
</html>
